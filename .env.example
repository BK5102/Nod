# Copy to .env.local and fill in. Never commit real values.

# SpacetimeDB (Maincloud). The browser reads the NEXT_PUBLIC_ pair; server routes read the plain pair.
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=
# Token for the server's own identity (the "agent" role). Server-only.
SPACETIMEDB_AGENT_TOKEN=

# Claude. Server-only.
ANTHROPIC_API_KEY=

# Bank. Server-only. BANK_ADAPTER is mock, increase or nessie.
BANK_ADAPTER=mock
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
INCREASE_API_KEY=
INCREASE_ACCOUNT_ID=
