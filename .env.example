# Copy to .env.local and fill in. Never commit real values.
# `pnpm db:setup` fills in the agent and operator tokens and the NEXT_PUBLIC_ pair for you.

# SpacetimeDB (Maincloud). The browser reads the NEXT_PUBLIC_ pair; server routes read the plain pair.
SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
SPACETIMEDB_DB_NAME=rerouted-calhacks13
NEXT_PUBLIC_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=rerouted-calhacks13

# Server-only identities. The agent can never approve; the operator runs the SIMULATED demo controls.
SPACETIMEDB_AGENT_TOKEN=
SPACETIMEDB_OPERATOR_TOKEN=

# Claude. Server-only.
ANTHROPIC_API_KEY=

# Flight search. Server-only. FLIGHT_PROVIDER=serpapi searches real current fares (Google Flights via
# SerpApi); FLIGHT_PROVIDER=duffel searches Duffel test mode (sandbox fares). Unset or any other value
# uses the saved demo offers. Any provider failure falls back to the saved offers. Search only: nothing books.
FLIGHT_PROVIDER=
SERPAPI_KEY=
DUFFEL_ACCESS_TOKEN=
